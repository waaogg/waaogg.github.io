{
  "name": "astro-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "deploy": "npm run build && node scripts/deploy-pages.mjs",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "content": "node --experimental-strip-types scripts/content.mjs",
    "contract": "node --experimental-strip-types scripts/generate-contract.mjs",
    "prebuild": "npm run content -- validate && npm run contract",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "test:publication": "node scripts/test-publication.mjs",
    "cloud:check": "node scripts/check-cloud-env.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@waline/client": "^3.16.1",
    "astro": "^7.3.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "pagefind": "^1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
