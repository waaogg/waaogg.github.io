---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MapPin, BookOpen, Hammer, Headphones, Sparkles, Clock, Compass, Info } from 'lucide-react';
import { siteConfig } from '../../site.config';

const nowData = siteConfig.now || {
  location: '中国 · 赛博空间',
  reading: '《代码整洁之道》',
  building: 'Astro 个人独立博客',
  listening: 'Lo-Fi Chill',
  status: '专注造物中，探索更多有趣的技术边界。',
  lastUpdated: '2026-10-15',
};
---

<BaseLayout
  title={`近况 /now - ${siteConfig.title}`}
  description="受 Derek Sivers 发起的 The /now 运动启发，这里记录了我此时此刻正在专注的事情。"
>
  <div class="space-y-10">
    <!-- Header with Reveal 1 -->
    <div class="border-b border-zinc-200/80 dark:border-zinc-800/80 pb-6 reveal-1 space-y-2">
      <div class="flex items-center justify-between">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2.5">
          <Compass className="w-6 h-6 text-indigo-500" />
          近况看板 · /now
        </h1>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200/60 dark:border-zinc-700/60">
          <Clock className="w-3.5 h-3.5 text-emerald-500" />
          <span>更新于 {nowData.lastUpdated}</span>
        </div>
      </div>
      <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
        比起静态的履历，这里记录的是我当下生命里正在倾注热情的真实切片。
      </p>
    </div>

    <!-- The 4 Pillars Bento Grid with Reveal 2 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 reveal-2">
      <!-- Location -->
      <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-900/50 backdrop-blur craft-card space-y-2.5">
        <div class="flex items-center gap-2 text-xs font-bold text-indigo-500 uppercase tracking-wider">
          <MapPin className="w-4 h-4" />
          <span>当前坐标</span>
        </div>
        <p class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
          {nowData.location}
        </p>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">
          保持身心平稳，在数字网络与现实世界之间自由穿梭。
        </p>
      </div>

      <!-- Reading -->
      <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-900/50 backdrop-blur craft-card space-y-2.5">
        <div class="flex items-center gap-2 text-xs font-bold text-amber-500 uppercase tracking-wider">
          <BookOpen className="w-4 h-4" />
          <span>正在研读</span>
        </div>
        <p class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
          {nowData.reading}
        </p>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">
          深读经典理论与工程哲学，建立耐得住时间考验的知识体系。
        </p>
      </div>

      <!-- Building -->
      <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-900/50 backdrop-blur craft-card space-y-2.5">
        <div class="flex items-center gap-2 text-xs font-bold text-emerald-500 uppercase tracking-wider">
          <Hammer className="w-4 h-4" />
          <span>正在打造</span>
        </div>
        <p class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
          {nowData.building}
        </p>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">
          亲手敲下每一行代码，享受将灵感转化为真实工程软件的快乐。
        </p>
      </div>

      <!-- Listening -->
      <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-900/50 backdrop-blur craft-card space-y-2.5">
        <div class="flex items-center gap-2 text-xs font-bold text-purple-500 uppercase tracking-wider">
          <Headphones className="w-4 h-4" />
          <span>单曲循环</span>
        </div>
        <p class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
          {nowData.listening}
        </p>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">
          在舒缓的节拍与音符流动中，保持沉浸与专注。
        </p>
      </div>
    </div>

    <!-- Current Reflections with Reveal 3 -->
    <section class="reveal-3 p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/70 dark:bg-zinc-900/40 backdrop-blur craft-card space-y-3">
      <div class="flex items-center gap-2 font-bold text-zinc-900 dark:text-zinc-100 text-sm">
        <Sparkles className="w-4 h-4 text-indigo-500" />
        <span>近期心境随想</span>
      </div>
      <p class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
        {nowData.status}
      </p>
    </section>

    <!-- Why /now Notion Callout with Reveal 4 -->
    <div class="reveal-4 p-4 rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700 bg-white/50 dark:bg-zinc-900/30 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed space-y-1">
      <div class="font-semibold text-zinc-800 dark:text-zinc-200 flex items-center gap-1.5">
        <Info className="w-3.5 h-3.5" /> 关于 “/now 页面运动”
      </div>
      <p>
        “/now 页面”由 Derek Sivers 发起，鼓励独立博客主用一个简单的常驻页面，告诉全世界你当下最在乎的事情。了解更多请访问 <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer" class="text-indigo-600 dark:text-indigo-400 hover:underline">nownownow.com</a>。
      </p>
    </div>
  </div>
</BaseLayout>
