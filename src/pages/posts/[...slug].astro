---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingControls from '../../components/ReadingControls.astro';
import Comments from '../../components/Comments.astro';
import { publishedPosts, postPath, formatDate, growthLabels, readingStats } from '../../lib/content';
import { siteConfig } from '../../site.config';
export async function getStaticPaths() {
  return (await publishedPosts()).map(post => ({ params: { slug: post.data.slug || post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = await publishedPosts();
const index = posts.findIndex(item => item.id === post.id);
const older = posts[index + 1], newer = posts[index - 1];
const related = posts.filter(item => item.id !== post.id && item.data.tags.some(tag => post.data.tags.includes(tag))).slice(0,3);
const stats = readingStats(post.body || '');
const url = new URL(postPath(post), siteConfig.site).href;
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.heroImage} article>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <header class="article-head reveal"><a class="text-link muted" href="/posts/">← 返回手记</a><div class="meta" style="margin-top:25px"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>·</span><span>{stats.words} 字 / 约 {stats.minutes} 分钟</span><span class="growth">{growthLabels[post.data.growth]}</span></div>
    <h1 data-pagefind-meta="title" transition:name={'post-title-' + post.data.contentId}>{post.data.title}</h1>
    <div class="tag-row">{post.data.tags.map(tag => <a class="tag" href={'/tags/' + encodeURIComponent(tag) + '/'}>#{tag}</a>)}</div>
    <p class="article-deck">{post.data.description}</p>
    {post.data.updatedDate && <p class="meta">更新于 {formatDate(post.data.updatedDate)}</p>}
  </header>
  <div class="article-layout">
    <div class="article-main">
      <TableOfContents headings={headings} mobile />
      {post.data.heroImage && <img src={post.data.heroImage} alt={post.data.heroAlt || post.data.title} width="1200" height="675" style="border-radius:6px;margin-bottom:30px" />}
      <article class="article-body" id="article-content" data-pagefind-body>
        <span hidden data-pagefind-ignore data-pagefind-meta="type">文章</span><span hidden data-pagefind-ignore data-pagefind-filter="type">文章</span>
        <Content />
      </article>
      <div class="article-footer"><p>写下这些文字的：{siteConfig.author}</p><p>内容采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a>。转载时请注明作者与原文链接。</p><a href={url}>{url}</a></div>
      <nav class="post-neighbors" aria-label="相邻文章">{older ? <a href={postPath(older)}><small>← 更早的文字</small><span>{older.data.title}</span></a> : <span></span>}{newer ? <a href={postPath(newer)}><small>更新的文字 →</small><span>{newer.data.title}</span></a> : <span></span>}</nav>
      {related.length > 0 && <section class="section" data-pagefind-ignore><p class="eyebrow">也许还想读</p>{related.map(item => <a class="mini-project" href={postPath(item)}><strong>{item.data.title} ↗</strong></a>)}</section>}
      <Comments path={postPath(post).replace(/\/$/, '')} />
    </div>
    <aside class="toc-aside"><TableOfContents headings={headings} /><ReadingControls /><p class="muted" style="font-size:10px;margin-top:18px">让文字以你喜欢的方式出现。</p><a class="text-link muted" style="font-size:10px;margin-top:15px" href="#comments">跳到评论 ↓</a></aside>
  </div>
  <div class="mobile-reading-settings"><ReadingControls /></div>
</BaseLayout>
