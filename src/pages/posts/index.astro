---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { publishedPosts, growthLabels } from '../../lib/content';
const posts = await publishedPosts();
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
const years = [...new Set(posts.map(post => post.data.pubDate.getFullYear()))];
---
<BaseLayout title="纸上片刻" description="长一点的思考，和正在生长的想法。">
  <div class="narrow"><header class="page-head reveal"><p class="eyebrow">THE WRITING ROOM</p><h1>纸上片刻<span class="accent">。</span></h1><p>把值得思考的事情慢慢展开。也欢迎那些尚未完整、仍在生长的想法。</p><span class="count">共 {posts.length} 篇手记 · 持续生长</span></header>
    <form class="filter-bar" id="post-filters" aria-label="筛选文章" inert aria-busy="true">
      <label class="sr-only" for="post-tag">按标签筛选</label><select class="filter-select" id="post-tag" name="tag" style="margin-left:0"><option value="">所有主题</option>{tags.map(tag => <option value={tag}>{tag}</option>)}</select>
      <label class="sr-only" for="post-year">按年份筛选</label><select class="filter-select" id="post-year" name="year" style="margin-left:0"><option value="">所有年份</option>{years.map(year => <option value={year}>{year}</option>)}</select>
      <label class="sr-only" for="post-growth">按生长状态筛选</label><select class="filter-select" id="post-growth" name="growth"><option value="">所有生长阶段</option>{Object.entries(growthLabels).map(([key,value]) => <option value={key}>{value}</option>)}</select>
      <button type="reset" class="text-link muted" style="border:0;font-size:11px">重置</button>
    </form>
    <div id="post-results">{posts.map(post => <div data-post-row data-tags={JSON.stringify(post.data.tags)} data-year={post.data.pubDate.getFullYear()} data-growth={post.data.growth}><PostRow post={post} /></div>)}</div>
    <p class="empty-state" id="post-empty" hidden>这个组合暂时没有文章，换个条件看看。</p>
    <nav class="pagination" id="post-pagination" aria-label="文章分页"><button class="filter-button" type="button" data-page-prev>上一页</button><span data-page-status aria-live="polite"></span><button class="filter-button" type="button" data-page-next>下一页</button></nav>
    <noscript><p class="muted">已展示全部文章。启用 JavaScript 可使用筛选与分页。</p></noscript>
  </div>
</BaseLayout>
<script>
  function initPostFilters() {
    const form = document.querySelector<HTMLFormElement>('#post-filters'); if (!form) return;
    const tag = form.querySelector<HTMLSelectElement>('[name=tag]')!, year = form.querySelector<HTMLSelectElement>('[name=year]')!, growth = form.querySelector<HTMLSelectElement>('[name=growth]')!;
    const params = new URLSearchParams(location.search); tag.value = params.get('tag') || ''; year.value = params.get('year') || ''; growth.value = params.get('growth') || '';
    let page = Math.max(1, Number(params.get('page')) || 1);
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-post-row]'));
    const render = (write = true) => {
      const filtered = rows.filter(row => (!tag.value || JSON.parse(row.dataset.tags || '[]').includes(tag.value)) && (!year.value || row.dataset.year === year.value) && (!growth.value || row.dataset.growth === growth.value));
      const count = Math.max(1, Math.ceil(filtered.length / 8)); page = Math.min(page, count);
      rows.forEach(row => row.hidden = true); filtered.slice((page - 1) * 8, page * 8).forEach(row => row.hidden = false);
      document.getElementById('post-empty')!.hidden = filtered.length > 0; document.getElementById('post-pagination')!.hidden = filtered.length <= 8;
      document.querySelector('[data-page-status]')!.textContent = page + ' / ' + count;
      document.querySelector<HTMLButtonElement>('[data-page-prev]')!.disabled = page === 1; document.querySelector<HTMLButtonElement>('[data-page-next]')!.disabled = page === count;
      if (write) { const next = new URLSearchParams(); if (tag.value) next.set('tag',tag.value); if (year.value) next.set('year',year.value); if (growth.value) next.set('growth',growth.value); if (page > 1) next.set('page',String(page)); history.replaceState(history.state,'',location.pathname + (next.size ? '?' + next : '')); }
    };
    form.onchange = () => { page = 1; render(); };
    form.onreset = event => { event.preventDefault(); tag.value = ''; year.value = ''; growth.value = ''; page = 1; render(); };
    document.querySelector<HTMLButtonElement>('[data-page-prev]')!.onclick = () => { page--; render(); form.scrollIntoView({ block:'start' }); };
    document.querySelector<HTMLButtonElement>('[data-page-next]')!.onclick = () => { page++; render(); form.scrollIntoView({ block:'start' }); };
    render(false); form.removeAttribute('inert'); form.setAttribute('aria-busy','false');
  }
  initPostFilters();
  document.addEventListener('astro:page-load', initPostFilters);
</script>
