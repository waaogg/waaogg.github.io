---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemoCard from '../../components/MemoCard.astro';
import { publishedMemos } from '../../lib/content';
const memos = await publishedMemos();
---
<BaseLayout title="日常留白" description="不必写成文章，也值得被记住的片刻。"><div class="narrow">
  <header class="page-head reveal"><p class="eyebrow">LIFE, IN SMALL PIECES</p><h1>日常留白<span class="accent">。</span></h1><p>一段没想完的话，一张路过时拍的照片。生活不只有郑重其事，也有这些小小的瞬间。</p><span class="count">{memos.length} 个生活片段</span></header>
  <div class="reveal delay-1">{memos.length ? memos.map(memo => <div data-memo-entry><MemoCard memo={memo} /></div>) : <div class="empty-state">留一页空白，等待下一次偶然。</div>}</div>
  <button class="filter-button" id="load-memos" type="button" hidden>再翻一些日常 ↓</button><p class="meta" id="memo-count" aria-live="polite"></p>
</div></BaseLayout>
<script>
  function initMemoList() {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-memo-entry]'));
    const button = document.querySelector<HTMLButtonElement>('#load-memos'); if (!button) return;
    let visible = 10;
    const update = () => { rows.forEach((row,index) => row.hidden = index >= visible); button.hidden = visible >= rows.length; document.getElementById('memo-count')!.textContent = '已展示 ' + Math.min(visible, rows.length) + ' / ' + rows.length + ' 个片段'; };
    button.onclick = () => { visible += 10; update(); }; update();
  }
  initMemoList();document.addEventListener('astro:page-load',initMemoList);
</script>
