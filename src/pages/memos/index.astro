---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Sparkles, Tag } from 'lucide-react';

const allMemos = await getCollection('memos');
const memos = allMemos.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="生活动态 · 碎碎念" description="无标题短文本、灵感火花与即刻微动态。">
  <div class="space-y-8">
    <!-- Header with Reveal 1 -->
    <div class="border-b border-zinc-200/80 dark:border-zinc-800/80 pb-6 reveal-1">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2.5">
        <Sparkles className="w-6 h-6 text-amber-500" />
        微动态 · 碎碎念
      </h1>
      <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
        不设长篇大论的负担，捕捉每一次偶得的灵感与日常片段。
      </p>
    </div>

    <!-- Memos Stream Timeline with Reveal 2 -->
    <div class="relative pl-6 sm:pl-8 border-l-2 border-indigo-200/60 dark:border-indigo-950/60 space-y-8 reveal-2">
      {memos.map((memo) => (
        <div class="relative group">
          <!-- Timeline Node Point with Glowing Ring -->
          <div class="absolute -left-[32px] sm:-left-[41px] top-1.5 w-4 h-4 rounded-full bg-white dark:bg-zinc-950 border-2 border-indigo-400 dark:border-indigo-600 group-hover:border-indigo-500 flex items-center justify-center transition-all duration-300 group-hover:scale-125">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 group-hover:bg-indigo-400 pulse-dot"></span>
          </div>

          <!-- Memo Card with Craft Card Hover Lift -->
          <div class="p-4.5 sm:p-5 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/70 dark:bg-zinc-900/50 backdrop-blur craft-card space-y-3">
            <div class="flex items-center justify-between text-xs text-zinc-400 dark:text-zinc-500 font-mono">
              <div class="flex items-center gap-2">
                <span class="text-lg select-none group-hover:scale-125 transition-transform duration-300">{memo.data.mood}</span>
                <time>{memo.data.date.toISOString().slice(0, 16).replace('T', ' ')}</time>
              </div>
            </div>

            <div class="text-sm text-zinc-800 dark:text-zinc-200 leading-relaxed whitespace-pre-line">
              {memo.body}
            </div>

            {memo.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 pt-1">
                {memo.data.tags.map((tag) => (
                  <span class="inline-flex items-center gap-0.5 px-2 py-0.5 text-[10px] rounded bg-zinc-200/60 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400">
                    <Tag className="w-2.5 h-2.5" />
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
