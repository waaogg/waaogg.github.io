---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WalineComments from '../../components/WalineComments';
import { User, Terminal, Cpu, Globe } from 'lucide-react';
import { siteConfig } from '../../site.config';

const skills = [
  { category: '前端工程', items: ['Astro', 'React', 'Tailwind CSS', 'TypeScript', 'Next.js'] },
  { category: '后端与云原生', items: ['Node.js', 'Python', 'Docker', 'PostgreSQL', 'Redis'] },
  { category: '效率与工具', items: ['Git', 'Linux', 'Vim / Neovim', 'CI/CD Pipelines'] },
];

const milestones = [
  {
    year: '2026',
    title: '持续学习与探索',
    detail: '关注现代 Web 工程架构、AI 赋能开发与极简交互设计。',
  },
  {
    year: '2025',
    title: '全栈实践与技术积累',
    detail: '探索前后端现代开发范式，完成多个开源工具与工程实践。',
  },
  {
    year: '启程',
    title: '开启个人博客',
    detail: '在赛博空间建立属于自己的数字花园，记录技术成长与生活随想。',
  },
];
---

<BaseLayout title={`关于 - ${siteConfig.author}`} description={siteConfig.bio}>
  <div class="space-y-10">
    <!-- Header / Hero Profile with Reveal 1 & 360 Spin Avatar -->
    <div class="reveal-1 flex flex-col sm:flex-row items-start sm:items-center gap-6 pb-8 border-b border-zinc-200/80 dark:border-zinc-800/80">
      <div class="relative group cursor-pointer shrink-0">
        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-indigo-500/25 via-purple-500/25 to-teal-500/25 blur-md opacity-75 group-hover:opacity-100 transition duration-500 group-hover:scale-105"></div>
        <div class="relative w-24 h-24 rounded-2xl overflow-hidden ring-2 ring-zinc-200/90 dark:ring-zinc-800 shadow-md bg-white dark:bg-zinc-900 avatar-spin">
          <img src={siteConfig.avatar} alt={siteConfig.author} class="w-full h-full object-cover" />
        </div>
      </div>

      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
          {siteConfig.author}
        </h1>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">
          {siteConfig.bio}
        </p>
        <div class="flex items-center gap-3 pt-1 text-xs text-zinc-500">
          <a href={siteConfig.site} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-indigo-500 transition-colors">
            <Globe className="w-3.5 h-3.5" />
            {siteConfig.site.replace(/^https?:\/\//, '')}
          </a>
          <span>·</span>
          <span class="inline-flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 pulse-dot"></span>
            开发者 / 创作者
          </span>
        </div>
      </div>
    </div>

    <!-- Bio Notion Blocks with Reveal 2 -->
    <section class="reveal-2 space-y-4">
      <h2 class="text-base font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
        <User className="w-4 h-4 text-indigo-500" />
        关于我与这个博客
      </h2>
      <div class="space-y-3 text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed p-4.5 rounded-xl bg-zinc-50/60 dark:bg-zinc-900/40 backdrop-blur border border-zinc-200/80 dark:border-zinc-800/80 craft-card">
        <p>
          你好，欢迎来到我的个人数字花园。
        </p>
        <p>
          我是一名热爱技术与创造的开发者。崇尚极简主义与工程美学，相信优秀的代码与设计能够创造持久的价值。
        </p>
      </div>
    </section>

    <!-- Skills Matrix with Reveal 3 -->
    <section class="reveal-3 space-y-4">
      <h2 class="text-base font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
        <Cpu className="w-4 h-4 text-indigo-500" />
        技术栈与工具箱
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {skills.map((group) => (
          <div class="p-4.5 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-900/50 backdrop-blur craft-card space-y-2.5">
            <div class="text-xs font-bold text-indigo-500 dark:text-indigo-400 uppercase tracking-wider">
              {group.category}
            </div>
            <div class="flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <span class="px-2 py-0.5 text-xs rounded bg-zinc-100 dark:bg-zinc-800 border border-zinc-200/80 dark:border-zinc-700/80 text-zinc-800 dark:text-zinc-200 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 hover:border-indigo-300 dark:hover:border-indigo-700 transition-colors">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Milestones Timeline with Reveal 4 -->
    <section class="reveal-4 space-y-4">
      <h2 class="text-base font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
        <Terminal className="w-4 h-4 text-indigo-500" />
        足迹与里程碑
      </h2>
      <div class="space-y-4 pl-4 border-l-2 border-indigo-200/60 dark:border-indigo-950/60">
        {milestones.map((m) => (
          <div class="space-y-1 relative group">
            <div class="absolute -left-[23px] top-1 w-3 h-3 rounded-full bg-white dark:bg-zinc-950 border-2 border-indigo-500 group-hover:scale-125 transition-transform"></div>
            <div class="text-xs font-mono font-bold text-indigo-500 dark:text-indigo-400">
              {m.year}
            </div>
            <div class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">
              {m.title}
            </div>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {m.detail}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Leave a Message with Reveal 5 -->
    <section class="reveal-5 pt-6 border-t border-zinc-200/80 dark:border-zinc-800/80">
      <WalineComments client:only="react" path="/about" />
    </section>
  </div>
</BaseLayout>
