---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Film, Book, Gamepad2, Music, Star, Calendar } from 'lucide-react';

const allMedia = await getCollection('media');
const mediaList = allMedia.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const typeLabels = {
  book: { label: '书籍', icon: Book },
  movie: { label: '电影', icon: Film },
  game: { label: '游戏', icon: Gamepad2 },
  music: { label: '音乐', icon: Music },
};

const statusLabels = {
  completed: '已完成',
  'in-progress': '进行中',
  wishlist: '计划中',
};
---

<BaseLayout title="书影音记录" description="阅读、观影、游戏与音乐个人评分及短评。">
  <div class="space-y-8">
    <!-- Header with Reveal 1 -->
    <div class="border-b border-zinc-200/80 dark:border-zinc-800/80 pb-6 reveal-1">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2.5">
        <Film className="w-6 h-6 text-indigo-500" />
        书影音足迹
      </h1>
      <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
        精神食粮与文化体验记录。评分仅代表当下个人主观心境。
      </p>
    </div>

    <!-- Media Cards Grid with Reveal 2 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4.5 reveal-2">
      {mediaList.map((item) => {
        const IconComponent = typeLabels[item.data.type].icon;
        return (
          <div class="flex flex-col justify-between p-5 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/90 dark:bg-zinc-900/60 backdrop-blur craft-card space-y-3 group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="inline-flex items-center gap-1.5 text-[11px] font-medium px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200/60 dark:border-zinc-700/60">
                  <IconComponent className="w-3 h-3 text-indigo-500" />
                  {typeLabels[item.data.type].label}
                </span>
                <span class="text-[11px] text-zinc-400 dark:text-zinc-500 font-mono">
                  {statusLabels[item.data.status]}
                </span>
              </div>

              <h2 class="text-base font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                {item.data.title}
              </h2>

              <!-- Star Rating with Hover Scale -->
              <div class="flex items-center gap-1 my-2.5 text-amber-500">
                {Array.from({ length: 5 }).map((_, i) => (
                  <Star
                    className={`w-3.5 h-3.5 transition-transform duration-200 group-hover:scale-110 ${
                      i < item.data.rating ? 'fill-current' : 'text-zinc-300 dark:text-zinc-700'
                    }`}
                  />
                ))}
                <span class="text-xs font-mono text-zinc-500 ml-1.5 font-semibold">
                  {item.data.rating}.0
                </span>
              </div>

              <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed italic border-l-2 border-indigo-200 dark:border-indigo-900/60 pl-3 my-2">
                “{item.data.review}”
              </p>
            </div>

            <div class="pt-2 text-[11px] font-mono text-zinc-400 dark:text-zinc-500 flex items-center justify-end gap-1.5">
              <Calendar className="w-3 h-3" />
              {item.data.date.toISOString().slice(0, 10)}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>
