---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCover from '../../components/BookCover.astro';
import { getCollection } from 'astro:content';
import { isPublished, formatDate } from '../../lib/publication';
const items = (await getCollection('media', ({data}) => isPublished(data))).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const types = {book:'书籍',movie:'电影',game:'游戏',music:'音乐'};
const status = {completed:'已完成','in-progress':'进行中',wishlist:'想体验'};
---
<BaseLayout title="精神食粮" description="书、电影、游戏与音乐留下的私人注脚。">
  <header class="page-head reveal"><p class="eyebrow">A SHELF OF INSPIRATION</p><h1>精神食粮<span class="accent">。</span></h1><p>在别人的故事里，遇见一点自己。留下一些主观的感受，给未来重逢时的自己。</p></header>
  <div class="filter-bar" id="media-filters" aria-label="筛选书影音" inert aria-busy="true"><div role="group" aria-label="内容类型" style="display:flex;gap:7px;flex-wrap:wrap"><button class="filter-button" type="button" data-media-type="" aria-pressed="true">全部</button>{Object.entries(types).map(([key,label]) => <button class="filter-button" type="button" data-media-type={key} aria-pressed="false">{label}</button>)}</div><label for="media-status" class="sr-only">体验状态</label><select class="filter-select" id="media-status"><option value="">所有状态</option>{Object.entries(status).map(([key,label]) => <option value={key}>{label}</option>)}</select></div>
  <div class="media-grid" data-pagefind-body><span hidden data-pagefind-ignore data-pagefind-meta="type">书影音</span>{items.map(item => <article class="media-card" id={item.id} data-media-entry data-type={item.data.type} data-status={item.data.status}><BookCover title={item.data.title} type={item.data.type} cover={item.data.cover} /><div><div class="meta">{types[item.data.type]} / {status[item.data.status]}</div><h2>{item.data.title}</h2>{item.data.creator && <small class="muted">{item.data.creator}</small>}{item.data.rating != null && <div class="stars" aria-label={'评分 ' + item.data.rating + '，满分 5'}>{'★'.repeat(Math.round(item.data.rating))}{'☆'.repeat(5-Math.round(item.data.rating))} <span class="muted">{item.data.rating.toFixed(1)}</span></div>}<p>{item.data.review || '先放进书架，留待下一次相遇。'}</p><time class="meta" datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>{item.data.url && <a class="text-link accent" href={item.data.url} target="_blank" rel="noopener noreferrer">了解更多 ↗</a>}</div></article>)}</div>
  <p class="empty-state" id="media-empty" hidden>这一格书架还是空的。</p><p class="meta" id="media-count" aria-live="polite" style="margin-top:25px"></p>
</BaseLayout>
<script>
  function initMediaFilters() {
    const filters = document.getElementById('media-filters'); if (!filters) return;
    const params = new URLSearchParams(location.search); let type = params.get('type') || '';
    const status = document.querySelector<HTMLSelectElement>('#media-status')!; status.value = params.get('status') || '';
    const update = (write=true) => {
      let count = 0; document.querySelectorAll<HTMLElement>('[data-media-entry]').forEach(row => { const visible = (!type || row.dataset.type === type) && (!status.value || row.dataset.status === status.value); row.hidden = !visible; if (visible) count++; });
      filters.querySelectorAll<HTMLElement>('[data-media-type]').forEach(button => button.setAttribute('aria-pressed',String(button.dataset.mediaType === type)));
      document.getElementById('media-empty')!.hidden = count > 0; document.getElementById('media-count')!.textContent = '这格书架上有 ' + count + ' 次相遇';
      if (write) { const query = new URLSearchParams(); if(type)query.set('type',type); if(status.value)query.set('status',status.value); history.replaceState(history.state,'',location.pathname+(query.size?'?'+query:'')+location.hash); }
    };
    filters.querySelectorAll<HTMLButtonElement>('[data-media-type]').forEach(button => button.onclick = () => {type=button.dataset.mediaType || '';update();}); status.onchange=()=>update();update(false);
    filters.removeAttribute('inert');filters.setAttribute('aria-busy','false');
  }
  initMediaFilters();document.addEventListener('astro:page-load',initMediaFilters);
</script>
