---
import ContentPage from '../../layouts/ContentPage.astro';
import pkg from '../../../package.json';
import { siteConfig } from '../../site.config';
const builtAt = new Date().toISOString();
---
<ContentPage id="colophon" eyebrow="BEHIND THE PAGES"><section class="section" style="margin-top:40px"><p class="eyebrow">BUILD NOTES / 真实构建信息</p><div class="stat-grid"><div><strong>Astro {pkg.dependencies.astro.replace('^','')}</strong><small>静态生成 / React 局部交互</small></div><div><strong>Pagefind</strong><small>构建后生成静态索引</small></div><div><strong>可迁移部署</strong><small>Pages / Nginx / 对象存储</small></div></div><p class="meta">构建时间 <time datetime={builtAt}>{new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',dateStyle:'medium',timeStyle:'short'}).format(new Date(builtAt))}</time></p><p class="muted" style="font-size:12px">评论服务：{siteConfig.waline.serverURL ? '已配置独立后端' : '等待接入'}。站点年龄仅表示自设定日期起的时间，不代表可用率。</p><a class="text-link accent" href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">查看代码与更新记录 ↗</a></section></ContentPage>
