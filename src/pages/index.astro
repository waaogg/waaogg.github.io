---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, Sparkles, FolderGit2, BookOpen, ExternalLink } from 'lucide-react';
import { siteConfig } from '../site.config';
import Hitokoto from '../components/Hitokoto';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter((post) => !post.data.isDraft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 3);

const allMemos = await getCollection('memos');
const recentMemos = allMemos
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<BaseLayout>
  <!-- Hero Section (ParticleX / Notion Hybrid with Stagger 1) -->
  <section class="space-y-6 pb-10 border-b border-zinc-200/80 dark:border-zinc-800/80 reveal-1">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
      <div class="flex items-center gap-5">
        <!-- Interactive 360 Spin Avatar with Halo -->
        <div class="relative group cursor-pointer">
          <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-indigo-500/20 via-purple-500/20 to-teal-500/20 blur-md opacity-75 group-hover:opacity-100 transition duration-500 group-hover:scale-105"></div>
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden ring-2 ring-zinc-200/90 dark:ring-zinc-800 shadow-md bg-white dark:bg-zinc-900 avatar-spin">
            <img src={siteConfig.avatar} alt={siteConfig.author} class="w-full h-full object-cover" />
          </div>
        </div>

        <div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2.5">
            {siteConfig.author}
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-normal bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200/70 dark:border-zinc-700/70">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 pulse-dot"></span>
              保持好奇 · 持续造物
            </span>
          </h1>
          <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
            {siteConfig.bio}
          </p>
        </div>
      </div>
    </div>

    <!-- Hitokoto Daily Inspiration Banner -->
    <div class="reveal-2">
      <Hitokoto client:load />
    </div>

    <!-- Notion Callout Block with Gentle Float & Stagger 2 -->
    <div class="reveal-2 flex items-start gap-3.5 p-4 rounded-xl bg-zinc-50/80 dark:bg-zinc-900/50 backdrop-blur border border-zinc-200/80 dark:border-zinc-800/80 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300 shadow-2xs hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
      <span class="text-xl select-none animate-bounce">💡</span>
      <div>
        欢迎来到我的个人数字空间。这里收录了我的长篇深度文章、日常微动态、开源与独立开发作品，以及书影音评价。
      </div>
    </div>
  </section>

  <!-- Recent Articles (Stagger 3) -->
  <section class="py-10 border-b border-zinc-200/80 dark:border-zinc-800/80 space-y-6 reveal-3">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
        <BookOpen className="w-4 h-4 text-zinc-500" />
        最新博文
      </h2>
      <a href="/posts" class="group text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 flex items-center gap-1 transition-colors">
        查看全部 <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

    <div class="space-y-4">
      {sortedPosts.map((post) => (
        <a
          href={`/posts/${post.id}`}
          class="group block p-4.5 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/90 dark:bg-zinc-900/60 backdrop-blur craft-card"
        >
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors flex items-center gap-2">
              {post.data.title}
              <ArrowRight className="w-3.5 h-3.5 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 text-indigo-500" />
            </h3>
            <time class="shrink-0 text-xs font-mono text-zinc-400 dark:text-zinc-500">
              {post.data.pubDate.toISOString().slice(0, 10)}
            </time>
          </div>
          <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400 line-clamp-2 leading-relaxed">
            {post.data.description}
          </p>
          <div class="mt-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              {post.data.tags.map((tag) => (
                <span class="inline-block px-2 py-0.5 text-[11px] rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 group-hover:bg-zinc-200/60 dark:group-hover:bg-zinc-700/60 transition-colors">
                  #{tag}
                </span>
              ))}
            </div>
            {post.data.growth && (
              <span class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500">
                {post.data.growth === 'seedling' ? '🌱 幼苗' : post.data.growth === 'budding' ? '🌿 育成' : '🌲 常青'}
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Projects (Stagger 4) -->
  <section class="py-10 border-b border-zinc-200/80 dark:border-zinc-800/80 space-y-6 reveal-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
        <FolderGit2 className="w-4 h-4 text-zinc-500" />
        精选项目
      </h2>
      <a href="/projects" class="group text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 flex items-center gap-1 transition-colors">
        全部项目 <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredProjects.map((project) => (
        <div class="flex flex-col justify-between p-4.5 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/90 dark:bg-zinc-900/60 backdrop-blur craft-card group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="font-semibold text-sm text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                {project.data.title}
              </span>
              {project.data.badge && (
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 font-medium border border-zinc-200/60 dark:border-zinc-700/60">
                  {project.data.badge}
                </span>
              )}
            </div>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-3 leading-relaxed">
              {project.data.description}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/60 flex items-center justify-between text-xs">
            <div class="flex flex-wrap gap-1">
              {project.data.tech.slice(0, 2).map((t) => (
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/60 text-zinc-500">
                  {t}
                </span>
              ))}
            </div>
            {project.data.demoUrl && (
              <a
                href={project.data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-zinc-700 dark:text-zinc-300 hover:text-indigo-600 dark:hover:text-indigo-400 flex items-center gap-1 font-medium transition-colors"
              >
                访问 <ExternalLink className="w-3 h-3" />
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Recent Memos (Stagger 5) -->
  <section class="py-10 space-y-6 reveal-5">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
        <Sparkles className="w-4 h-4 text-zinc-500" />
        微动态 / 碎碎念
      </h2>
      <a href="/memos" class="group text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 flex items-center gap-1 transition-colors">
        更多动态 <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

    <div class="space-y-3.5">
      {recentMemos.map((memo) => (
        <div class="p-4.5 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/70 dark:bg-zinc-900/50 backdrop-blur craft-card">
          <div class="flex items-center gap-2 text-xs text-zinc-400 dark:text-zinc-500 mb-2">
            <span class="text-base select-none">{memo.data.mood}</span>
            <time>{memo.data.date.toISOString().slice(0, 16).replace('T', ' ')}</time>
          </div>
          <div class="text-sm text-zinc-800 dark:text-zinc-200 leading-relaxed">
            {memo.body}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
