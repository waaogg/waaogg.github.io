---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/publication';
import { ArrowUpRight } from 'lucide-react';
const projects = (await getCollection('projects', ({data}) => isPublished(data))).sort((a,b) => a.data.order - b.data.order);
const stages = {building:'正在打磨',active:'持续维护',complete:'已完成',archived:'已归档'};
---
<BaseLayout title="手里的作品" description="把想法变成具体事物的过程。">
  <header class="page-head reveal"><p class="eyebrow">THINGS I'VE MADE</p><h1>手里的作品<span class="accent">。</span></h1><p>一些实用的工具，一些好奇心驱动的实验。每一次动手，都让想法离现实近一点。</p></header>
  <div class="project-grid reveal delay-1">{projects.map((project,index) => <article class="project-card">
    <a class="project-cover" href={'/projects/' + project.id + '/'} aria-label={'查看 ' + project.data.title}>{project.data.cover ? <img src={project.data.cover} alt={project.data.title} width="800" height="400" loading="lazy" /> : <><span class="cover-type">PROJECT / {String(index+1).padStart(2,'0')}</span><span class="cover-symbol">{index === 0 ? '{ / }' : index === 1 ? 'a → b' : '◌'}</span></>}</a>
    <div class="project-card-body"><div class="meta"><span class="status-dot">{stages[project.data.stage]}</span>{project.data.badge && <span>{project.data.badge}</span>}</div><h2><a href={'/projects/' + project.id + '/'}>{project.data.title}</a></h2><p>{project.data.description}</p><div class="tag-row">{project.data.tech.map(tech => <span class="tag">{tech}</span>)}</div><div class="project-links"><a class="text-link" href={'/projects/' + project.id + '/'}>了解作品 <ArrowUpRight size={12} /></a>{project.data.githubUrl && project.data.githubUrl !== 'https://github.com' && <a class="text-link muted" href={project.data.githubUrl} target="_blank" rel="noopener noreferrer">源代码 ↗</a>}</div></div>
  </article>)}</div>
  {!projects.length && <div class="empty-state">新想法正在路上。</div>}
</BaseLayout>
