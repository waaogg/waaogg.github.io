---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/publication';
import { siteConfig } from '../../site.config';
const friends = await getCollection('friends', ({data}) => isPublished(data));
---
<BaseLayout title="朋友的小岛" description="去别人的世界坐坐。">
  <header class="page-head reveal"><p class="eyebrow">NEIGHBOURS ON THE INTERNET</p><h1>朋友的小岛<span class="accent">。</span></h1><p>互联网很大，能偶尔串门的小角落很珍贵。这些是值得停下来读一读的地方。</p></header>
  <div class="friend-grid">{friends.map(friend => <a class="friend-card" href={friend.data.url} target="_blank" rel="noopener noreferrer">{friend.data.avatar ? <img src={friend.data.avatar} alt="" width="42" height="42" loading="lazy" data-avatar-fallback={friend.data.name.slice(0,1)} /> : <span class="friend-avatar">{friend.data.name.slice(0,1)}</span>}<div><strong>{friend.data.name} ↗</strong><p>{friend.data.description}</p><span class="meta">{friend.data.tag}</span></div></a>)}</div>
  <section class="callout narrow" style="margin-top:50px"><h2>交换一扇窗</h2><p>如果你也在认真记录生活，欢迎留下你的网站。请附上名称、网址、简介和头像地址，收录前会先去你的小站看看。</p><p class="meta" style="margin-top:18px">本站信息</p><p>{siteConfig.title}<br />{siteConfig.description}<br /><a class="accent" href={siteConfig.site}>{siteConfig.site}</a></p></section>
  <div class="narrow"><Comments path="/friends" title="留下你的地址" /></div>
</BaseLayout>
