---
import { render, type CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';
interface Props { memo: CollectionEntry<'memos'>; }
const { memo } = Astro.props;
const { Content } = await render(memo);
---
<article class="memo" id={memo.id}>
  <div class="meta"><span>{memo.data.mood}</span><time datetime={memo.data.date.toISOString()}>{formatDate(memo.data.date)}</time><a href={'/memos/' + memo.id + '/'} aria-label={'查看 ' + formatDate(memo.data.date) + ' 的动态'}>↗</a></div>
  <div class="memo-content"><Content /></div>
  {memo.data.images.length > 0 && <div class="memo-gallery">{memo.data.images.map(img => <figure><img src={img.src} alt={img.alt} loading="lazy" width="640" height="480" />{img.caption && <figcaption class="muted" style="font-size:11px;margin-top:6px">{img.caption}</figcaption>}</figure>)}</div>}
  {memo.data.tags.length > 0 && <div class="tag-row">{memo.data.tags.map(tag => <span class="tag">#{tag}</span>)}</div>}
</article>
