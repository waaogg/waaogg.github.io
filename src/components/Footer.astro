---
import { ArrowUpRight } from 'lucide-react';
import { siteConfig } from '../site.config';
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <div><span class="brand-name" style="font-size:18px">{siteConfig.title}</span><p class="muted" style="font-size:11px;margin:7px 0 0">{siteConfig.bio}</p></div>
      <nav class="footer-links" aria-label="页脚导航">
        <a href="/guestbook/">写一条留言 ↗</a><a href="/gallery/">影像</a><a href="/library/">阅读角落</a><a href="/updates/">更新</a><a href="/about/">关于</a><a href="/rss.xml">RSS <ArrowUpRight size={10} style={{display:'inline'}} /></a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {siteConfig.author} · 文字与日常，自在生长。</span>
      <span>{siteConfig.features.siteAge && <span data-site-age={siteConfig.siteStartDate}></span>}<button type="button" data-motion-toggle style="border:0;margin-left:15px;font:inherit;color:inherit" aria-pressed="false">减少动态效果</button><button type="button" data-help-open style="border:0;margin-left:15px;font:inherit;color:inherit" aria-label="查看键盘快捷键">? 快捷键</button></span>
    </div>
  </div>
</footer>
