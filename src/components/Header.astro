---
import ThemeToggle from './ThemeToggle';
import { Search, ChevronDown, Dices } from 'lucide-react';
import { siteConfig } from '../site.config';
import { getCollection } from 'astro:content';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const allPosts = await getCollection('posts');
const validPostUrls = allPosts
  .filter((p) => !p.data.isDraft)
  .map((p) => `/posts/${p.id}`);

const primaryNav = [
  { label: '首页', href: '/' },
  { label: '文章', href: '/posts' },
  { label: '动态', href: '/memos' },
  { label: '留言', href: '/guestbook' },
];

const secondaryNav = [
  { label: '开源项目', href: '/projects', desc: '独立产品与工程实践' },
  { label: '书影音', href: '/media', desc: '书籍、电影与游戏足迹' },
  { label: '近况 /now', href: '/now', desc: '当前正在专注的事情' },
  { label: '友情链接', href: '/friends', desc: '常去逛的博友小岛' },
  { label: '关于博主', href: '/about', desc: '技能栈与履历时间线' },
  { label: '幕后账本', href: '/colophon', desc: '技术底座与工程指标' },
];

const isSecondaryActive = secondaryNav.some(
  (item) => currentPath === item.href || currentPath.startsWith(item.href)
);
---

<header
  class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/80 dark:bg-zinc-950/80 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors"
  transition:name="global-header"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand / Avatar with 360 Spin -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <div class="relative w-8 h-8 rounded-full overflow-hidden ring-1 ring-zinc-300 dark:ring-zinc-700 group-hover:ring-zinc-500 transition-all avatar-spin">
        <img
          src={siteConfig.avatar}
          alt={siteConfig.author}
          class="w-full h-full object-cover"
        />
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
          {siteConfig.author}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation (Primary + Layered Dropdown) -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-zinc-600 dark:text-zinc-400">
      {primaryNav.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'relative px-3 py-1.5 rounded-lg text-sm transition-all duration-200 active:scale-95',
              isActive
                ? 'text-zinc-900 dark:text-zinc-100 bg-zinc-100 dark:bg-zinc-800/80 font-semibold shadow-xs'
                : 'hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100/60 dark:hover:bg-zinc-800/40',
            ]}
          >
            {item.label}
          </a>
        );
      })}

      <!-- Secondary "探索 ▾" Dropdown -->
      <div class="relative group">
        <button
          type="button"
          class:list={[
            'flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm transition-all duration-200 cursor-pointer',
            isSecondaryActive
              ? 'text-zinc-900 dark:text-zinc-100 bg-zinc-100 dark:bg-zinc-800/80 font-semibold'
              : 'hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100/60 dark:hover:bg-zinc-800/40',
          ]}
        >
          <span>探索</span>
          <ChevronDown className="w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-200 text-zinc-400" />
        </button>

        <!-- Dropdown Menu Card -->
        <div class="absolute left-0 top-full pt-1.5 hidden group-hover:block w-56 z-50 animate-in fade-in slide-in-from-top-1 duration-150">
          <div class="p-1.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md shadow-lg space-y-0.5">
            {secondaryNav.map((subItem) => {
              const isSubActive = currentPath === subItem.href || currentPath.startsWith(subItem.href);
              return (
                <a
                  href={subItem.href}
                  class:list={[
                    'flex flex-col px-3 py-2 rounded-lg text-xs transition-colors',
                    isSubActive
                      ? 'bg-zinc-100 dark:bg-zinc-800 text-indigo-600 dark:text-indigo-400 font-semibold'
                      : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100/80 dark:hover:bg-zinc-800/70',
                  ]}
                >
                  <span class="font-medium text-zinc-900 dark:text-zinc-100">{subItem.label}</span>
                  <span class="text-[10px] text-zinc-400 dark:text-zinc-500 mt-0.5">{subItem.desc}</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </nav>

    <!-- Actions (Lucky Dice, Search & Theme) -->
    <div class="flex items-center gap-1.5 shrink-0">
      <!-- Lucky Random Post Portal -->
      <button
        id="random-post-btn"
        type="button"
        data-posts={JSON.stringify(validPostUrls)}
        title="随便逛逛 (随机传送)"
        aria-label="随便逛逛"
        class="p-2 text-zinc-500 hover:text-indigo-600 dark:text-zinc-400 dark:hover:text-indigo-400 rounded-lg hover:bg-zinc-100/80 dark:hover:bg-zinc-800/60 transition-all duration-200 active:scale-90"
      >
        <Dices className="w-4 h-4" />
      </button>

      <!-- Search Trigger -->
      <button
        id="search-btn"
        type="button"
        aria-label="搜索全站文章"
        class="flex items-center gap-2 px-2.5 py-1.5 text-xs text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 bg-zinc-50/50 dark:bg-zinc-900/50 transition-all duration-200 active:scale-95"
      >
        <Search className="w-3.5 h-3.5" />
        <span class="hidden sm:inline">搜索</span>
        <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-zinc-200/60 dark:bg-zinc-800/80 rounded text-zinc-600 dark:text-zinc-400">
          ⌘K
        </kbd>
      </button>

      <ThemeToggle client:load />

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="打开菜单"
        class="md:hidden p-2 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 rounded-lg transition-all duration-200 active:scale-90"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-950/95 backdrop-blur px-4 pt-2 pb-5 space-y-4 shadow-lg">
    <div class="space-y-1">
      <div class="text-[10px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-3 mb-1">核心导航</div>
      {primaryNav.map((item) => (
        <a
          href={item.href}
          class="block px-3 py-2 text-sm font-medium rounded-lg text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="space-y-1 pt-2 border-t border-zinc-100 dark:border-zinc-800/60">
      <div class="text-[10px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider px-3 mb-1">探索发现</div>
      <div class="grid grid-cols-2 gap-1">
        {secondaryNav.map((subItem) => (
          <a
            href={subItem.href}
            class="block px-3 py-2 text-xs font-medium rounded-lg text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 transition-colors"
          >
            {subItem.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeaderInteractions() {
    // 1. Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuBtn && mobileMenu) {
      menuBtn.onclick = () => {
        mobileMenu.classList.toggle('hidden');
      };
    }

    // 2. Lucky Dice Random Post
    const diceBtn = document.getElementById('random-post-btn');
    if (diceBtn) {
      diceBtn.onclick = () => {
        const postsData = diceBtn.getAttribute('data-posts');
        if (postsData) {
          try {
            const list: string[] = JSON.parse(postsData);
            if (list.length > 0) {
              const randomUrl = list[Math.floor(Math.random() * list.length)];
              window.location.href = randomUrl;
            }
          } catch (e) {
            console.error('Random post error:', e);
          }
        }
      };
    }
  }

  // Re-run on View Transition page changes
  setupHeaderInteractions();
  document.addEventListener('astro:page-load', setupHeaderInteractions);
</script>
