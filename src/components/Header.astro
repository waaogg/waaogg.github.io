---
import { Search, Menu, SunMoon, ChevronDown, ArrowUpRight, BookOpen } from 'lucide-react';
import { siteConfig } from '../site.config';
const path = Astro.url.pathname;
const active = (href: string) => path.startsWith(href);
---
<header class="site-header" transition:name="site-header">
  <div class="shell header-row">
    <a class="brand" href="/" aria-label={siteConfig.title + '，首页'}>
      <span class="brand-mark" aria-hidden="true"><BookOpen size={17} strokeWidth={1.2} /></span>
      <span><span class="brand-name">{siteConfig.title}</span><span class="brand-sub">{siteConfig.subtitle}</span></span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {siteConfig.navigation.map(item => <a class="nav-link" href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
      <details class="explore">
        <summary class="nav-link">更多 <ChevronDown size={12} /></summary>
        <div class="explore-panel">
          {siteConfig.explore.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}><span>{item.label}<small style="display:block">{item.description}</small></span><ArrowUpRight size={13} /></a>)}
        </div>
      </details>
    </nav>
    <div class="header-actions">
      <button class="search-trigger" type="button" data-search-open aria-label="搜索全站内容"><Search size={16} strokeWidth={1.5} /><span>搜索</span><kbd>⌘ K</kbd></button>
      <button class="icon-button" type="button" data-theme-toggle aria-label="切换主题：跟随系统" title="切换亮色、暗色或跟随系统"><SunMoon size={17} strokeWidth={1.5} /></button>
      <button class="icon-button mobile-toggle" type="button" data-menu-open aria-label="打开导航菜单" aria-controls="mobile-menu" aria-expanded="false"><Menu size={19} strokeWidth={1.5} /></button>
    </div>
  </div>
</header>
<dialog class="mobile-menu" id="mobile-menu" aria-label="网站导航">
  <div class="mobile-menu-head"><span class="brand-name">{siteConfig.title}</span><button class="icon-button" data-menu-close aria-label="关闭导航菜单" type="button">✕</button></div>
  <p class="eyebrow">去哪里看看</p>
  <nav aria-label="手机导航">
    <a href="/">首页</a>
    {[...siteConfig.navigation,...siteConfig.explore].map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <p class="eyebrow">留一点时间给自己</p><p class="muted" style="font-size:12px">{siteConfig.bio}</p>
</dialog>
