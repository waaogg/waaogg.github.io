<div class="reading-controls" role="group" aria-label="阅读设置">
  <button type="button" data-font="sans" aria-pressed="true">无衬线</button>
  <button type="button" data-font="serif" aria-pressed="false">衬线</button>
  <button type="button" data-size="-1" aria-label="减小字号">A−</button>
  <button type="button" data-size="1" aria-label="增大字号">A＋</button>
</div>
