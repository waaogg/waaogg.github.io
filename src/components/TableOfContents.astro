---
interface Props { headings: { depth: number; slug: string; text: string }[]; mobile?: boolean; }
const { headings, mobile = false } = Astro.props;
const items = headings.filter(item => item.depth === 2 || item.depth === 3);
---
{items.length > 0 && (mobile ? <details class="mobile-toc"><summary>本篇目录 · {items.length} 个小节</summary><ul>{items.map(item => <li style={item.depth === 3 ? 'padding-left:12px' : ''}><a href={'#' + item.slug}>{item.text}</a></li>)}</ul></details>
  : <nav class="toc-nav" aria-label="文章目录"><p>ON THIS PAGE</p><ul>{items.map(item => <li class:list={{ 'toc-nested': item.depth === 3 }}><a href={'#' + item.slug} data-toc-target={item.slug}>{item.text}</a></li>)}</ul></nav>)}
