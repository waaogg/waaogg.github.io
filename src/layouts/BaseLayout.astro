---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal';
import KeyboardShortcuts from '../components/KeyboardShortcuts';
import { siteConfig } from '../site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.avatar,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteTitle = title === siteConfig.title ? title : `${title} · ${siteConfig.title}`;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Native View Transitions (SPA Fluidity) -->
    <ClientRouter />

    <!-- Anti-FOUC Theme Initialization & View Transition Swap Sync -->
    <script is:inline>
      function applyTheme() {
        const theme = (() => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark';
          }
          return 'light';
        })();

        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }

      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col relative bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 transition-colors selection:bg-zinc-200 dark:selection:bg-zinc-800 bg-grain">
    <!-- Dynamic Ambient Background Aurora (Inspired by ParticleX organic morphing loops) -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0 opacity-40 dark:opacity-25" aria-hidden="true">
      <div class="absolute -top-32 -left-32 w-96 h-96 bg-gradient-to-tr from-indigo-200/50 via-purple-200/40 to-transparent dark:from-indigo-900/30 dark:via-purple-900/20 blur-3xl aurora-blob-1"></div>
      <div class="absolute top-1/3 -right-32 w-96 h-96 bg-gradient-to-br from-emerald-100/50 via-teal-100/40 to-transparent dark:from-emerald-950/30 dark:via-cyan-900/20 blur-3xl aurora-blob-2"></div>
    </div>

    <!-- Persistent Header -->
    <div class="relative z-40">
      <Header currentPath={currentPath} />
    </div>

    <!-- Main Content Area with Silky View Transition -->
    <main
      class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 md:py-12 relative z-10"
      data-pagefind-body
      transition:animate="fade"
    >
      <slot />
    </main>

    <!-- Footer -->
    <div class="relative z-10">
      <Footer />
    </div>

    <!-- Global Client Search Modal -->
    <SearchModal client:load />

    <!-- Global Keyboard Shortcuts Modal (?) -->
    <KeyboardShortcuts client:load />
  </body>
</html>
