---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal';
import MusicPlayer from '../components/MusicPlayer';
import { siteConfig } from '../site.config';
import '../styles/global.css';
import '../styles/discovery.css';
import {publicCatalog} from '../lib/discovery';
const catalog=await publicCatalog();
interface Props { title?: string; description?: string; image?: string; article?: boolean; noindex?: boolean; }
const { title = siteConfig.title, description = siteConfig.description, image, article = false, noindex = false } = Astro.props;
const pageTitle = title === siteConfig.title ? title : title + ' · ' + siteConfig.title;
const canonical = new URL(Astro.url.pathname, siteConfig.site).href;
const imageURL = new URL(image || siteConfig.avatar, siteConfig.site).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title><meta name="description" content={description} /><meta name="author" content={siteConfig.author} />
    <link rel="canonical" href={canonical} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <meta name="color-scheme" content="light dark" /><meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={imageURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('journal-theme');
          document.documentElement.classList.toggle('dark', saved === 'dark' || ((!saved || saved === 'system') && matchMedia('(prefers-color-scheme: dark)').matches));
          document.documentElement.dataset.motion = localStorage.getItem('journal-motion') || 'on';
        } catch {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header />
    <main class="shell main-content" id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    <SearchModal client:load transition:persist="global-search" />
    {siteConfig.features.music && <MusicPlayer client:load transition:persist="global-music" />}
    <dialog id="shortcut-dialog" class="dialog-panel help-dialog" aria-labelledby="shortcut-title">
      <form method="dialog"><button class="icon-button" aria-label="关闭快捷键" style="float:right">✕</button></form>
      <h2 id="shortcut-title">让浏览更顺手</h2>
      <div class="shortcut-row"><span>搜索内容</span><span><kbd>Ctrl / ⌘</kbd> <kbd>K</kbd></span></div>
      <div class="shortcut-row"><span>返回首页 / 文章 / 日常</span><span><kbd>g</kbd> <kbd>h / p / m</kbd></span></div>
      <div class="shortcut-row"><span>向下 / 向上滚动</span><span><kbd>j</kbd> <kbd>k</kbd></span></div>
      <div class="shortcut-row"><span>关闭菜单或弹层</span><kbd>Esc</kbd></div>
      <div class="shortcut-row"><span>打开帮助</span><kbd>?</kbd></div>
    </dialog>
    <dialog id="image-dialog" class="lightbox" aria-label="查看图片"><button type="button" data-lightbox-close aria-label="关闭图片">✕</button><figure><img alt=""/><figcaption data-image-caption></figcaption><p role="status" data-image-error hidden>图片暂时无法加载，可以切换下一张或关闭后重试。</p></figure><div class="lightbox-controls"><button type="button" data-image-prev aria-label="上一张图片">←</button><span data-image-position aria-live="polite"></span><button type="button" data-image-next aria-label="下一张图片">→</button></div></dialog>
    <p class="library-toast" role="status" data-library-toast hidden></p>
    <script is:inline type="application/json" id="library-catalog" set:html={JSON.stringify(catalog).replace(/</g,'\\u003c')}/>
    <script>import '../lib/runtime';</script>
  </body>
</html>
